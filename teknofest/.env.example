# Copy to teknofest/.env. That file is git-ignored; this example is not.
# Real environment variables always take precedence over these values.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Keycloak / OIDC
OIDC_OP_ISSUER=http://127.0.0.1:8080/realms/teknofest
OIDC_RP_CLIENT_ID=teknofest-web
OIDC_RP_CLIENT_SECRET=change-me

# Keycloak container and realm import
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
KEYCLOAK_REALM=teknofest
APP_URL=http://127.0.0.1:8000
